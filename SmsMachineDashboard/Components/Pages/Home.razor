@page "/"
@rendermode InteractiveServer
@using SmsMachine.Dashboard.Components.Shared
@using SmsMachine.Dashboard.Models
@using SmsMachine.Dashboard.Services
@inject ICampaignService CampaignService
@inject NavigationManager Nav

<h2 class="mb-1">Benvenuto 👋</h2>
<p class="text-muted mb-4">
    Qui trovi un riepilogo veloce delle campagne.
</p>

@if (isLoading)
{
    <p>Caricamento…</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (summary is null)
{
    <div class="alert alert-info">Nessun dato disponibile.</div>
}
else
{
     <CampaignSummaryPanel Summary="summary!" />

    <div class="d-flex gap-2">
        <button class="btn btn-primary"
                @onclick="@(() => Nav.NavigateTo("/createcampaign"))">
            + Nuova campagna
        </button>

        <button class="btn btn-outline-secondary"
                @onclick="@(() => Nav.NavigateTo("/campaignslist"))">
            Vai alle campagne
        </button>
    </div>
}

@code {
    bool isLoading = true;
    string? errorMessage;
    CampaignSummaryDTO? summary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            summary = await CampaignService.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel caricamento: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
