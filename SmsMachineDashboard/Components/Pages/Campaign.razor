@page "/campaign/{id:int}"
@rendermode InteractiveServer
@using SmsMachineDashboard.Models
@inject CampaignService campaignService


<h2>Dettaglio Campagna</h2>

@if (campaign == null)
{
    <p>Campagna non trovata</p>
}
else
{
    <div class ="form-group m-3">
        <h3><b>Titolo:</b> @campaign.Title</h3>
        <ul>
            <li><b>Messaggio: </b>@campaign.Text</li>
            <li><b>Numeri: </b>@campaign.RecipientList</li>
            <li><b>Data di creazione: </b>@campaign.CreatedAt</li>
            <li><b>Descrizione: </b>@campaign.Description</li>
            <li><b>Stato: </b>@campaign.Status</li>
        </ul>
        <button class="btn btn-warning rounded" @onclick="SendCampaign">Send</button>
        
        <NavLink class="nav-link" href="@($"/editcampaign/{campaign.Id}")">
            <button class="btn btn-primary">Edit Campaign</button>
        </NavLink> 

    </div>

}

@code {
    [Parameter]
    public int Id { get; set; }

    private CampaignSms campaign;

    protected override async Task OnInitializedAsync()
    {
        campaign = await campaignService.GetCampaignIdAsync(Id);
    }

    protected async Task SendCampaign()
    {
        await campaignService.SendCampaignAsync(campaign.Id);
    }
}