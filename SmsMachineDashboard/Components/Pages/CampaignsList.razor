@page "/campaignslist"
@using SmsMachine.Dashboard.Models
@using SmsMachine.Dashboard.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject CampaignService campaignService
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<h1 class="mb-3">Campagne</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-sm-4">
                <label class="form-label">Titolo</label>
                <input class="form-control" @bind="query.Title" @bind:event="oninput" />
            </div>

            <div class="col-sm-3">
                <label class="form-label">Da</label>
                <InputDate TValue="DateTime?" class="form-control" @bind-Value="query.From" />
            </div>

            <div class="col-sm-3">
                <label class="form-label">A</label>
                <InputDate TValue="DateTime?" class="form-control" @bind-Value="query.To" />
            </div>

            <div class="col-sm-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="ApplyFilters">Filtra</button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <p>Sto recuperando le campagne...</p>
}
else if (data.Total == 0)
{
    <div class="alert alert-info">Nessuna campagna presente.</div>
}
else
{
    <CampaignsTable Items="data.Items"
                    TotalCount="data.Total"
                    CurrentPage="query.Page"
                    PageSize="query.PageSize"
                    OnEdit="HandleEdit"
                    OnSend="HandleSend"
                    OnDelete="HandleDelete" />

    <div class="mt-2">
        <Pager CurrentPage="query.Page"
               PageSize="query.PageSize"
               TotalCount="data.Total"
               OnPageChanged="HandlePageChanged"
               OnPageSizeChanged="HandlePageSizeChanged" />
    </div>
}

@code {
    private CampaignSearchQuery query = new() { Page = 1, PageSize = 10 };
    private PagedResult<CampaignListDTO> data = new();
    private bool isLoading = true;
    string? errorMessage;

    private string? fromStr
    {
        get => query.From?.ToString("yyyy-MM-dd");
        set => query.From = string.IsNullOrWhiteSpace(value) ? null : DateTime.Parse(value);
    }
   
    private string? toStr
    {
        get => query.To?.ToString("yyyy-MM-dd");
        set => query.To = string.IsNullOrWhiteSpace(value) ? null : DateTime.Parse(value);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadAsync();
    }
    private async Task ReloadAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // CHANGED: chiama il backend con query server-side (title, from, to, page, size)
            data = await campaignService.SearchAsync(query);
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel caricamento: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // --- Eventi/azioni ---

    private Task HandleEdit(int id)
    {
        Nav.NavigateTo($"/campaigns/{id}/edit");
        return Task.CompletedTask;
    }

    private async Task HandleSend(int id)
    {
        var resp = await campaignService.SendCampaignAsync(id);
        if (!resp.IsSuccessStatusCode)
        {
            var msg = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Invio fallito: {msg}");
        }
        await ReloadAsync(); // refresh per aggiornare stato riga
        }
    private async Task HandleDelete(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminare definitivamente la campagna {id}?");
        if (!ok) return;

        var resp = await campaignService.DeleteCampaignAsync(id);
        if (!resp.IsSuccessStatusCode)
        {
            var msg = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Errore eliminazione : {msg}");
        }
        await ReloadAsync(); // refresh pagina corrente (server-side)
    }
    private async Task ApplyFilters()
    {
        query.Page = 1; // reset alla prima pagina quando cambi filtri
        await ReloadAsync();
    }

    private async Task HandlePageChanged(int newPage)
    {
        query.Page = newPage;
        await ReloadAsync();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        query.PageSize = newSize;
        query.Page = 1;
        await ReloadAsync();
    }

    }

   