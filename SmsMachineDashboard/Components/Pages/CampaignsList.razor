@page "/campaignslist"
@using SmsMachine.Dashboard.Models
@inject CampaignService campaignService
@rendermode InteractiveServer
@inject IJSRuntime JS


<h1>Campagne esistenti</h1>
@if(isLoading)
{
    <p>Sto recuperando le campagne...</p>
}
else
{    
    @if (campagne == null)
    {
        <p>Campagne non trovate</p>
    }
    else
    {
        <ul>
            @foreach (var c in campagne)
            {
                <NavLink class="nav-link" href="@($"/campaign/{c.Id}")"><h3>@c.Title</h3></NavLink>
                <li><b>Messaggio: </b>@c.Text</li>
                <li>
                    <b>Numeri:</b>
                    <div style="width: 50%; max-height:100px; overflow:auto; white-space: pre-wrap; word-wrap: break-word; padding:5px; border-radius:5px;">
                        @c.RecipientList
                    </div>
                </li>
                <li><b>Data di creazione: </b>@c.CreatedAt</li>
                <li><b>Descrizione Campagna: </b>@c.Description</li>
                <li><b>Stato: </b>@c.Status</li>
                <li>
                    <a class="btn btn-sm btn-outline-primary custom-btn" href="@($"/campaign/{c.Id}/edit")">
                        Modifica
                    </a>
                    <button class="btn btn-sm btn-warning ms-2" @onclick="() => SendCampaign(c.Id)">Invia</button>
                    <button class="btn btn-sm btn-danger ms-2" @onclick="() => Delete(c.Id)">Elimina</button>
                </li>
                <br/>
            }
        </ul>
    }
}

@code {
    List<CampaignDetails>? campagne;
    public bool isLoading = true;
    string? message;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            campagne = await campaignService.GetAllCampaignsAsync();
            isLoading = false;
            StateHasChanged();
        }       
    }

    protected async Task SendCampaign(int id)
    {
        await campaignService.SendCampaignAsync(id);
    }

    private async Task Delete(int id)
    {
        // conferma di eliminazione
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminare definitivamente la campagna {id}?");
        if (!ok) return;

        var resp = await campaignService.DeleteCampaignAsync(id);
        if (resp.IsSuccessStatusCode)
        {
            campagne?.RemoveAll(x => x.Id == id);
            message = "Campagna SMS eliminata con successo.";
            StateHasChanged();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Errore eliminazione : {msg}");
        }
    }
}