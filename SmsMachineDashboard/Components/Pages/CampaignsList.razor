@page "/campaignslist"
@using SmsMachine.Dashboard.Models
@using SmsMachine.Dashboard.Components.Shared
@inject CampaignService campaignService
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<h1 class="mb-3">Campagne</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p>Sto recuperando le campagne...</p>
}
else if (campagne is null || campagne.Count == 0)
{
    <div class="alert alert-info">Nessuna campagna presente.</div>
}
else
{
    <FiltersBar Filters="filters" OnChange="ApplyFilters" />

    <CampaignsTable Items="Paged"
                    TotalCount="FilteredCount"
                    PageState="page"
                    OnEdit="HandleEdit"
                    OnSend="HandleSend"
                    OnDelete="HandleDelete" />

    <Pager State="page"
           TotalCount="FilteredCount"
           OnPageChanged="HandlePageChanged"
           OnPageSizeChanged="HandlePageSizeChanged" />
}

@code {
    private List<CampaignDetails>? campagne;
    private bool isLoading = true;

    private PageState page = new(); // stato di paginazione
    private CampaignFilters filters = new(); // stato filtri
    string? errorMessage;

    //  collezione filtrata
    private IEnumerable<CampaignDetails> Filtered => (campagne ?? new())
        .Where(c =>
            string.IsNullOrWhiteSpace(filters.Title)
            || (c.Title?.Contains(filters.Title, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    private int FilteredCount => Filtered.Count();

    //  paginazione applicata sulla collezione filtrata
    private IEnumerable<CampaignDetails> Paged => Filtered
        .Skip((page.CurrentPage - 1) * page.PageSize)
        .Take(page.PageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return; 

        try
        {
            isLoading = true;
            StateHasChanged(); 

            campagne = await campaignService.GetAllCampaignsAsynViews();
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel caricamento : {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); 
        }
    }

    // --- Eventi/azioni ---

    private Task HandleEdit(int id)
    {
        Nav.NavigateTo($"/campaigns/{id}/edit");
        return Task.CompletedTask;
    }

    private async Task HandleSend(int id)
    {
        var resp = await campaignService.SendCampaignAsync(id);
        if (resp.IsSuccessStatusCode)
        {
            // ricarico per aggiornare lo stato righe
            campagne = await campaignService.GetAllCampaignsAsync();
            StateHasChanged();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Invio fallito: {msg}");
        }
    }

    private async Task HandleDelete(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminare definitivamente la campagna {id}?");
        if (!ok) return;

        var resp = await campaignService.DeleteCampaignAsync(id);
        if (resp.IsSuccessStatusCode)
        {
            campagne?.RemoveAll(x => x.Id == id);

            // se la pagina è vuota dopo la delete, torna indietro
            if (campagne != null && (page.CurrentPage - 1) * page.PageSize >= campagne.Count && page.CurrentPage > 1)
                page.CurrentPage--;

            StateHasChanged();
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Errore eliminazione : {msg}");
        }
    }

    private void HandlePageChanged(int newPage)
    {
        page.CurrentPage = newPage;
    }

    private void HandlePageSizeChanged(int newSize)
    {
        page.PageSize = newSize;
        page.CurrentPage = 1;
    }
    private Task ApplyFilters() // quando cambia il filtro, torna alla pagina 1
    {
        page.CurrentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
