@page "/campaignslist"
@using SmsMachine.Dashboard.Models
@using SmsMachine.Dashboard.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using SmsMachine.Dashboard.Services
@inject ICampaignService campaignService
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<h1 class="mb-3">Campagne</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
<CampaignFilterPanel Query="query" OnSearch="ApplyFilters" />

@if (isLoading)
{
    <p>Sto recuperando le campagne...</p>
}
else if (data.Total == 0)
{
    <div class="alert alert-info">Nessuna campagna presente.</div>
}
else
{
    <CampaignsTable Items="data.Items"
                    TotalCount="data.Total"
                    CurrentPage="query.Page"
                    PageSize="query.PageSize"
                    
                    OnSend="HandleSend"
                    OnDelete="HandleDelete" />

    <div class="mt-2">
        <Pager CurrentPage="query.Page"
               PageSize="query.PageSize"
               TotalCount="data.Total"
               OnPageChanged="HandlePageChanged"
               OnPageSizeChanged="HandlePageSizeChanged" />
    </div>
}

@code {
    private CampaignSearchQuery query = new() { Page = 1, PageSize = 10 };
    private PagedResult<CampaignListDTO> data = new();
    private bool isLoading = true;
    string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // chiama il backend con query server-side (title, from, to, page, size)
            data = await campaignService.SearchAsync(query);
        }
        catch (Exception ex)
        {
            errorMessage = $"Errore nel caricamento: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // --- Eventi/azioni ---
    private async Task HandleSend(int id)
    {
        //qui deve rimanere un bool tue o false, la logica va nel service
        var result = await campaignService.SendCampaignAsync(id);
        if (!result)
        {       
            await JS.InvokeVoidAsync("alert", $"Invio fallito");
        }
        await ReloadAsync(); // refresh per aggiornare stato riga
     }

    private async Task HandleDelete(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Eliminare definitivamente la campagna {id}?");
        if (!ok) return;

        var result = await campaignService.DeleteCampaignAsync(id);
        if (!result)
        {
            await JS.InvokeVoidAsync("alert", $"Errore eliminazione");
        }
        await ReloadAsync(); // refresh pagina corrente (server-side)
    }

    private async Task ApplyFilters()
    {
        query.Page = 1; // reset alla prima pagina quando cambi filtri
        await ReloadAsync();
    }

    private async Task HandlePageChanged(int newPage)
    {
        query.Page = newPage;
        await ReloadAsync();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        query.PageSize = newSize;
        query.Page = 1;
        await ReloadAsync();
    }
}

   