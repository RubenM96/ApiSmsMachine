@page "/campaign/{id:int}/edit"
@using SmsMachine.Dashboard.Models
@inject CampaignService campaignService
@inject NavigationManager Nav
@rendermode InteractiveServer

<h3>Modifica Campagna SMS</h3>

<EditForm Model="@form" OnValidSubmit="@Save" FormName="CampaignEditForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group m-3">
        <label>Nome Campagna:</label>
        <InputText id="title" @bind-Value="form.Title" />
    </div>

    <div class="form-group m-3">
        <label>Testo:</label>
        <InputText id="text" @bind-Value="form.Text" />
    </div>

    <div class="form-group m-3">
        <label>Numeri di Telefono:</label>
        <InputTextArea id="numbers" @bind-Value="form.RecipientList" class="form-control" style="width:50%; height:150px; resize: vertical; overflow:auto;" />
    </div>

    <div class="form-group m-3">
        <label>Notifica:</label>
        <InputCheckbox id="notify" @bind-Value="form.CampaignNotify" />
    </div>

    <div class="form-group m-3">
        <label>Descrizione:</label>
        <InputText id="description" @bind-Value="form.Description" />
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Salva</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Back">Annulla</button>
    </div>
</EditForm>

@code {
    [Parameter] public int id { get; set; }

    CampaignForm form = new();

    protected override async Task OnInitializedAsync()
    {
        var dto = await campaignService.GetCampaignIdAsync(id);
        if (dto != null)
        {
            form = new CampaignForm
            {
                Title = dto.Title,
                Text = dto.Text,
                RecipientList = dto.RecipientList,
                CampaignNotify = dto.CampaignNotify,
                Description = dto.Description
            };
        }
    }

    private async Task<HttpResponseMessage> Save()
    {
        var response = await campaignService.UpdateCampaignAsync(id, form);
        Nav.NavigateTo("/campaignslist", forceLoad: true);
        return response;
    }

    private void Back() => Nav.NavigateTo("/campaignslist");
}