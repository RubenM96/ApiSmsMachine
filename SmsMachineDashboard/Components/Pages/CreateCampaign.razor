@page "/createcampaign"
@using SmsMachineDashboard.Models
@using System.ComponentModel.DataAnnotations
@inject CampaignService campaignService
@inject NavigationManager Nav
@rendermode InteractiveServer


<h3>Nuova Campagna SMS</h3>

@if (!string.IsNullOrEmpty(message))
{
<div class="alert alert-success">@message</div>
}

<EditForm Model="@campaignForm" OnValidSubmit="@CampaignFormSubmit" FormName="CampaignForm">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group m-3">
        <label>Nome Campagna: </label>
        <InputText id="title" @bind-Value="@campaignForm.Title"></InputText>
    </div>

    <div class="form-group m-3">
        <label >Testo:</label>
        <InputText id="text" @bind-Value="@campaignForm.Text"></InputText>
    </div>

    <div class="form-group m-3">
        <label>Numeri di Telefono:</label>
        <InputText id="numbers" @bind-Value="@campaignForm.RecipientList"></InputText>
    </div>

    <div class="form-group m-3">
        <label>Notifica:</label>
    <InputCheckbox id="notify" @bind-Value="@campaignForm.CampaignNotify"></InputCheckbox>
    </div>

    <div class="form-group m-3">
        <label>Descrizione:</label>
        <InputText id="description" @bind-Value="@campaignForm.Description"></InputText>
    </div>
    
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Salva</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Back">Annulla</button>
    </div>
</EditForm>


@code {
    CampaignForm campaignForm = new();
    string? message;

    private async Task CampaignFormSubmit()
    {
        var resp = await campaignService.CreateCampaignAsync(campaignForm);

        if (resp.IsSuccessStatusCode)
        {
            message = "Campagna creata con successo.";

            campaignForm = new();
        }
        else
        {
            var err = await resp.Content.ReadAsStringAsync();
            message = null; // niente messaggio di successo
            Console.WriteLine($"Errore creazione campagna: {err}");
        }
    }

    private void Back() => Nav.NavigateTo("/campaignslist");
}
