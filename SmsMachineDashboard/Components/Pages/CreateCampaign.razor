@page "/createcampaign"
@using SmsMachineDashboard.Models
@using System.ComponentModel.DataAnnotations
@inject CampaignService campaignService
@rendermode InteractiveServer


<h3>Nuova Campagna SMS</h3>

<EditForm Model="@campaignForm" OnValidSubmit="@CampaignFormSubmit" FormName="CampaignForm">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group m-3">
        <label>Title: </label>
        <InputText id="title" @bind-Value="@campaignForm.Title"></InputText>
    </div>

    <div class="form-group m-3">
        <label >Text:</label>
        <InputText id="text" @bind-Value="@campaignForm.Text"></InputText>
    </div>

    <div class="form-group m-3">
        <label>Numbers:</label>
        <InputText id="numbers" @bind-Value="@campaignForm.RecipientList"></InputText>
    </div>

    <div class="form-group m-3">
        <label>Notify:</label>
    <InputCheckbox id="notify" @bind-Value="@campaignForm.CampaignNotify"></InputCheckbox>
    </div>

    <div class="form-group m-3">
        <label>Description:</label>
        <InputText id="description" @bind-Value="@campaignForm.Description"></InputText>
    </div>
    
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</EditForm>


@code {
    CampaignForm campaignForm = new();

    private async Task CampaignFormSubmit()
    {
        await campaignService.CreateCampaignAsync(campaignForm);
        campaignForm = new();
    }
}
