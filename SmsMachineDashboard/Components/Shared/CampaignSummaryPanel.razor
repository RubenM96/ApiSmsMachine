@using SmsMachine.Dashboard.Models

<div class="card p-3 shadow-sm mb-4">
    <h5 class="mb-3">Riepilogo campagne</h5>

    <div class="row g-3">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted">In bozza</div>
                <div class="fs-3 fw-semibold">@Summary.Draft</div>
            </div>
            <i class="bi bi-pencil-square fs-4 text-muted"></i>
        </div>
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted">In corso</div>
                <div class="fs-3 fw-semibold">@Summary.InProgress</div>
            </div>
            <i class="bi bi-arrow-repeat fs-4 text-muted"></i>
        </div>
        

        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted">Terminate</div>
                <div class="fs-3 fw-semibold">@Summary.Finished</div>
            </div>
            <i class="bi bi-check2-circle fs-4 text-muted"></i>
        </div>
    </div>

    <div class="text-muted mt-3 small">
        Totale campagne: <strong>@Summary.Total</strong>
    </div>
</div>

@code {
    [Parameter] public CampaignSummaryDTO Summary { get; set; } = default!;
}
