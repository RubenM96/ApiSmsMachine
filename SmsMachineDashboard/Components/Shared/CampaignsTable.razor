@using SmsMachine.Dashboard.Models
@using SmsMachine.Dashboard.Components.Shared

<div class="d-flex align-items-center justify-content-between mb-2">
    <div class="small text-muted">
        Mostrando @((Start + 1))–@(End) di @TotalCount campagne
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th class="text-start">Titolo</th>
                <th class="text-center" style="width:140px;">Destinatari</th>
                <th class="text-center" style="width:140px;">Stato</th>
                <th class="text-nowrap" style="width:180px;">Creato</th>
                <th class="text-center" style="width:320px;">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Items)
            {
                <tr>
                    <!-- Titolo -->
                    <td class="text-truncate" style="max-width: 420px;" title="@c.Title">@c.Title</td>

                    <!-- Totale destinatari (centrato) -->
                    <td class="text-center">@c.TotalRecipients</td>

                    <!-- Stato come badge (centrato) -->
                    <td class="text-center">
                        <span class="badge @StatusClass(c.Status)" style="color:black">@c.Status.ToString()</span>
                    </td>

                    <!-- Creato (formattato) -->
                    <td class="text-nowrap">@c.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>

                    <!-- Azioni (allineate a destra) -->
                    <td class="text-center">
                    <CampaignTableButtons c="c"

                                          OnDelete="OnDelete"
                                          
                                          OnSend="OnSend" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@code {
    [Parameter] public IEnumerable<CampaignListDTO> Items { get; set; } = Enumerable.Empty<CampaignListDTO>();
    [Parameter] public int TotalCount { get; set; }

    
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;

    [Parameter] public EventCallback<int> OnSend { get; set; }

    [Parameter] public EventCallback<int> OnDelete { get; set; }

    int Start => Math.Max(0, (CurrentPage - 1) * PageSize);
    int End => Math.Min(CurrentPage * PageSize, TotalCount);

    static string StatusClass(CampaignListDTO.CampaignStatus status) => status switch
    {
        CampaignListDTO.CampaignStatus.Draft => "text-bg-secondary",
        CampaignListDTO.CampaignStatus.InProgress => "text-bg-warning",
        CampaignListDTO.CampaignStatus.Finished => "text-bg-success",
        _ => "text-bg-light"
    };
}