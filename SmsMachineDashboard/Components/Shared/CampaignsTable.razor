@using SmsMachine.Dashboard.Models

<div class="d-flex align-items-center justify-content-between mb-2">
    <div class="small text-muted">
        Mostrando @((Start + 1))–@(End) di @TotalCount campagne
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm align-middle table-hover">
        <thead class="table-light">
            <tr>
                <th style="width: 56px;">#</th>
                <th>Titolo</th>
                <th>Tot. Numeri</th>
                <th>Creato</th>
                <th>Stato</th>
                <th style="width: 280px;">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Items)
            {
                <tr>
                    <td>@c.Id</td>
                    <td class="text-truncate" style="max-width: 420px;" title="@c.Title">@c.Title</td>
                    <td>@c.TotalRecipients</td>
                    <td>@c.CreatedAt</td>
                    <td><span class="badge @StatusClass(c.Status) black-text" style="color: black;">@c.Status.ToString()</span></td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary me-2"
                           href="@($"/campaign/{c.Id}")"
                           title="Dettagli" aria-label="Dettagli">
                            <i class="bi bi-search"></i>
                        </a>

                        <a class="btn btn-sm btn-outline-primary me-2" href="@($"/campaign/{c.Id}/edit")">Modifica</a>

                        <button class="btn btn-sm btn-danger me-2" @onclick="() => OnDelete.InvokeAsync(c.Id)">Elimina</button>

                        @if (c.Status != CampaignDetails.CampaignStatus.Finished)
                        {
                            <button class="btn btn-sm btn-warning" @onclick="() => OnSend.InvokeAsync(c.Id)">Invia</button>
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IEnumerable<CampaignDetails> Items { get; set; } = Enumerable.Empty<CampaignDetails>();
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public PageState PageState { get; set; } = default!;
    [Parameter] public EventCallback<int> OnEdit { get; set; }   // opzionale (non usato qui)
    [Parameter] public EventCallback<int> OnSend { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    int Start => (PageState.CurrentPage - 1) * PageState.PageSize;
    int End => Math.Min(PageState.CurrentPage * PageState.PageSize, TotalCount);

    static string StatusClass(CampaignDetails.CampaignStatus status) => status switch
    {
        CampaignDetails.CampaignStatus.Draft => "text-bg-secondary",
        CampaignDetails.CampaignStatus.InProgress => "text-bg-warning",
        CampaignDetails.CampaignStatus.Finished => "text-bg-success",
        _ => "text-bg-light"
    };
}